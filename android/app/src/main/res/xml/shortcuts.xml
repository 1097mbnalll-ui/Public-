<?xml version="1.0" encoding="utf-8"?>
<!-- long-press the app icon: «مصروف جديد» opens the expense form straight away -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="expense"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_expense"
        android:shortcutLongLabel="@string/shortcut_expense_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.madar.planner"
            android:targetClass="io.github.madar.planner.MainActivity"
            android:data="madar://expense" />
    </shortcut>
</shortcuts>
